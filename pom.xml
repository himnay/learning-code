<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.org.llm</groupId>
        <artifactId>super-pom</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.org.learning</groupId>
    <artifactId>learning-code</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Learning :: Java code</name>
    <description>Runnable Java examples and interview problems referenced from the learning notes</description>

    <!-- Java version, Spring Boot, JUnit and every other dependency version come from super-pom /
         learning-bom. Only commons-collections4 is pinned here, because the BOM doesn't manage it. -->

    <properties>
        <!-- A library of examples, not an application: there is no main class to repackage. -->
        <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
        <commons-collections4.version>4.6.0</commons-collections4.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The exercises are named after the problem they solve, not *Test, so surefire's
                         default patterns never ran them. Keep the defaults and add the exercise names. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/Problem*.java</include>
                        <include>**/CompetitiveProblems.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
