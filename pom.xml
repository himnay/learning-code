<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.org.llm</groupId>
        <artifactId>super-pom</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.org.learning</groupId>
    <artifactId>learning-code</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Learning :: Java code</name>
    <description>Runnable Java examples and interview problems referenced from the learning notes</description>

    <properties>
        <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
        <commons-collections4.version>4.6.0</commons-collections4.version>
        <!-- Allure: allure-java's JUnit Jupiter adapter writes target/allure-results while the tests
             run, and allure-maven turns them into an Allure 2 report (github.com/allure-framework/allure2). -->
        <allure-java.version>3.0.0</allure-java.version>
        <allure-maven.version>3.1.0</allure-maven.version>
        <allure-report.version>2.46.1</allure-report.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure-java.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Registers itself with the JUnit Platform through the ServiceLoader: nothing to annotate. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The test knowledge graph (com.org.learning.report) is a JUnit Platform TestExecutionListener. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The exercises are named after the problem they solve, not *Test, so surefire's
                         default patterns never ran them. Keep the defaults and add the exercise names. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/Problem*.java</include>
                        <include>**/CompetitiveProblems.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!-- mvn allure:report -> target/site/allure-maven-plugin/index.html; mvn allure:serve opens it -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <!-- A 2.x version selects the Allure 2 report; the plugin defaults to Allure 3. -->
                    <reportVersion>${allure-report.version}</reportVersion>
                    <!-- One self-contained index.html that opens straight from the file system. -->
                    <singleFile>true</singleFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
